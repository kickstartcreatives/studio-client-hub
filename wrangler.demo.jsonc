{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "studio-client-hub-demo",
  "compatibility_date": "2026-07-01",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./.demo-dist",
