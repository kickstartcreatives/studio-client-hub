{
  "name": "studio-client-hub",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --local",
    "db:migrate:local": "wrangler d1 migrations apply studio-client-hub --local",
    "db:seed:local": "wrangler d1 execute studio-client-hub --local --file=./seed.sql",
    "test": "wrangler deploy --dry-run --outdir=.test-build && node --test",
    "check": "npm test && npm audit --audit-level=high",
    "setup": "node scripts/setup.mjs"
  },
  "devDependencies": {
    "miniflare": "5.20261023.3-beta",
    "wrangler": "4.156.0"
  },
  "description": "Self-hosted client CRM and portal for independent web designers.",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/kickstartcreatives/studio-client-hub.git"
  }
}
